{
  "name": "cfm-calculator",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Verbal's CFM calculator - Capacitor modernization of the legacy App Inventor app",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:identity": "vitest run tests/identity.test.ts",
    "cap:sync": "cap sync android",
    "verify:splash": "node scripts/verify-splash-asset.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
